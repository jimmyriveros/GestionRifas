# =============================================================================
# Sistema de Gestión de Rifas — variables de entorno de EJEMPLO
# =============================================================================
# Copiar como .env.local y completar con valores reales.
# NUNCA versionar .env, .env.local ni ningún archivo con claves reales.
# Este archivo solo contiene marcadores de posición.
#
# Ver docs/SECURITY.md §7 y docs/ARCHITECTURE.md §12.
# =============================================================================

# -----------------------------------------------------------------------------
# Supabase — públicas (llegan al navegador, quedan sujetas a RLS)
# -----------------------------------------------------------------------------
NEXT_PUBLIC_SUPABASE_URL="https://<project-ref>.supabase.co"
# Dashboard de Supabase -> Connect -> "Publishable key" (docs/DECISIONS.md D-028).
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY="<publishable-key>"

# -----------------------------------------------------------------------------
# Supabase — SECRETA (solo servidor)
# -----------------------------------------------------------------------------
# Omite RLS por completo. No usar el prefijo NEXT_PUBLIC_.
# No importar nunca desde componentes cliente. En Vercel, marcar como sensible.
SUPABASE_SERVICE_ROLE_KEY="<service-role-key>"

# -----------------------------------------------------------------------------
# Aplicación
# -----------------------------------------------------------------------------
# URL pública de la aplicación; la usan los enlaces de recuperación de contraseña.
NEXT_PUBLIC_SITE_URL="http://localhost:3000"

# La zona horaria del proceso se fija en UTC a propósito: la conversión a
# America/Bogota es explícita en la capa de presentación (ver D-022).
TZ="UTC"

# -----------------------------------------------------------------------------
# Datos de desarrollo (seed) — solo entorno local, nunca en producción
# -----------------------------------------------------------------------------
# Contraseña usada por scripts/seed-users.ts para las cuentas de prueba.
# Definir localmente. Nunca versionar una contraseña real.
SEED_DEFAULT_PASSWORD=""

# -----------------------------------------------------------------------------
# Solo para aplicar migraciones/generar tipos con la Supabase CLI apuntando a
# un proyecto remoto (Session pooler, puerto 5432; password percent-encoded).
# La aplicación Next.js NUNCA lee esta variable. Opcional si se usa Supabase
# local (Fase 2) en su lugar.
# -----------------------------------------------------------------------------
SUPABASE_DB_URL=""

# -----------------------------------------------------------------------------
# Pruebas end-to-end (Playwright) — se instala cuando existan specs reales
# -----------------------------------------------------------------------------
E2E_BASE_URL="http://localhost:3000"
E2E_OWNER_EMAIL="owner@demo.test"
E2E_ADMIN_EMAIL="admin@demo.test"
E2E_SELLER_EMAIL="vendedor1@demo.test"
E2E_PASSWORD=""

# -----------------------------------------------------------------------------
# Sincronización de loterías — solo servidor
# -----------------------------------------------------------------------------
# Secreto del Route Handler /api/lottery/sync. Mínimo 16 caracteres.
# En producción (Etapa 6, D-149) Vercel inyecta CRON_SECRET al declarar crons
# y el programador envía Authorization: Bearer con ese valor. La aplicación
# acepta LOTTERY_SYNC_SECRET o, si falta, CRON_SECRET. Si pones los dos,
# tienen que ser el mismo: el handler prefiere LOTTERY_SYNC_SECRET y el cron
# envía CRON_SECRET.
LOTTERY_SYNC_SECRET=""
